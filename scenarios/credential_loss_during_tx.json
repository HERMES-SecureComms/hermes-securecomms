{
  "name": "credential-loss-during-tx",
  "steps": [
    {"action": "attach_credential", "credential_id": "GLOVE-001", "expect": {"auth_state": "AUTHORIZED"}},
    {"action": "ptt_press", "expect": {"decision": "ALLOW"}},
    {"action": "detach_credential", "expect": {"auth_state": "GRACE_PERIOD", "decision": "ALLOW"}},
    {"action": "advance_time", "milliseconds": 1000, "expect": {"decision": "ALLOW", "ptt_state": "PRESSED"}},
    {"action": "advance_time", "milliseconds": 500, "expect": {"decision": "DENY_CREDENTIAL_EXPIRED", "ptt_state": "PRESSED", "tx_enabled": false}}
  ]
}

